{
  "name": "xiryn",
  "version": "0.7.0",
  "description": "Xiryn, the open-source personal agent: does everything Muse, Grok Bot and Dots do on your own computer. Each agent gets its own Linux desktop in Docker, with your keys and any model.",
  "keywords": [
    "ai-agents",
    "agent",
    "local-first",
    "self-hosted",
    "open-source",
    "privacy",
    "computer-use",
    "sandbox",
    "docker",
    "firecrawl",
    "telegram-bot",
    "llm",
    "openai",
    "anthropic",
    "ollama",
    "ai-sdk",
    "nextjs",
    "sqlite",
    "multi-agent",
    "byok"
  ],
  "homepage": "https://xiryn.com",
  "bugs": {
    "url": "https://github.com/SouravBeraAkaSpeed/xiryn/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SouravBeraAkaSpeed/xiryn.git"
  },
  "author": {
    "name": "Sourav Bera",
    "url": "https://souravbera.vercel.app"
  },
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "setup:local": "node scripts/setup.mjs --local",
    "workstation:build": "node scripts/setup.mjs --workstation-only",
    "dev": "next dev --hostname 127.0.0.1 --port 6796",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 6796",
    "background": "node scripts/background.mjs",
    "open": "node scripts/open.mjs",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/deepseek": "^3.0.63",
    "@ai-sdk/google": "^4.0.93",
    "@ai-sdk/groq": "^4.0.59",
    "@ai-sdk/mistral": "^4.0.62",
    "@ai-sdk/openai": "^4.0.91",
    "@ai-sdk/openai-compatible": "^3.0.67",
    "@ai-sdk/react": "^4.0.140",
    "@ai-sdk/xai": "^5.0.20",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@novnc/novnc": "^1.7.0",
    "@streamdown/code": "^2.0.0",
    "ai": "^7.0.137",
    "ai-sdk-ollama": "4.5.1",
    "better-sqlite3": "~12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "drizzle-zod": "^0.8.3",
    "lucide-react": "^1.55.0",
    "nanoid": "^6.0.2",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.89.0",
    "react-resizable-panels": "^4.14.4",
    "streamdown": "^2.7.0",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "use-stick-to-bottom": "^1.1.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22",
    "@types/novnc__novnc": "^1.6.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5"
  }
}
